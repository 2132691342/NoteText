# NoteText · EditorConfig
#
# 与 .gitattributes 的 LF 约定互为补充：编辑器层面也统一行尾与缩进，
# 否则「文件在磁盘上是 LF，编辑器保存时写回 CRLF」会让门禁时好时坏。
# 具体规则与理由见 AGENTS.md §2.9。

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
# Rust 生态统一 4 空格缩进（rustfmt 默认），与前端 2 空格不同，必须分开写。
indent_size = 4

[*.md]
# Markdown 的行尾两个空格是有意的换行手段，不能裁掉。
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
